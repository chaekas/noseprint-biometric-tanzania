# PostgreSQL connection used by the API
DATABASE_URL=postgresql+psycopg://noseprint:noseprint_dev_password@localhost:5432/noseprint

# Local-only image storage root
STORAGE_DIR=storage

# Baseline feature extractor
MODEL_NAME=resnet18_imagenet1k_v1
MODEL_VERSION=resnet18-imagenet1k-v1
EMBEDDING_DIM=512

# Candidate matching threshold is provisional and MUST be calibrated on validation data.
# Do not interpret similarity as probability or proof of identity.
MATCH_THRESHOLD=0.75

# Upload constraints
MAX_IMAGE_MB=10
